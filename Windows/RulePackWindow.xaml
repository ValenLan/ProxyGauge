<Window x:Class="ProxyGauge.RulePackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge 规则包"
        Width="650"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/ProxyGauge.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="规则包" FontSize="13" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Margin="0,4,5,4" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                              Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentTintBrush}">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,-1,0,0">
                        <TextBlock Text="ProxyGauge 规则包" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="分流规则与 TUN DNS" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="9" Padding="10,5" VerticalAlignment="Top">
                        <TextBlock Text="不含订阅" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,17,0,0">
                    <StackPanel>
                        <TextBlock Text="适用于 Clash Verge Rev 的 Merge 配置，不读取节点、订阅地址或凭据。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="默认策略组名为 PROXY；若订阅使用其他名称，请替换规则最后一列。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="导入后启用该 Merge 配置，并刷新当前订阅。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="规则预览" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="12 条域名规则 · 版本 2026.08" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBox Grid.Row="2"
                             Text="{Binding RuleText}"
                             Style="{StaticResource FieldStyle}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="10"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>

                <Grid Grid.Row="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource QuietButtonStyle}" Content="复制 YAML" Width="100" Click="CopyButton_Click" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="导出…" Width="88" Margin="9,0,0,0" Click="ExportButton_Click" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource QuietButtonStyle}" Content="完成" Width="88" HorizontalAlignment="Right" Click="CloseButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
