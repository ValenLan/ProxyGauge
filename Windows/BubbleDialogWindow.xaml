<Window x:Class="ProxyGauge.BubbleDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProxyGauge"
        Width="410"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBubble" Width="52" Height="52" CornerRadius="26"
                        Background="{DynamicResource AccentSurfaceBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Viewbox Width="25" Height="25">
                        <Path x:Name="DialogIcon" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource QuietButtonStyle}"
                        MinWidth="78" IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="88" Margin="9,0,0,0" IsDefault="True" Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
