<Window x:Class="ProxyGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge" Width="820" Height="550"
        MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Icon="Assets/ProxyGauge.ico" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DashboardCardButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18" Padding="18">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/ProxyGauge.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="ProxyGauge" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,5,4">
                        <Button Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="设置" ToolTip="连接与更新设置" Click="SettingsButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M8,6.2 A1.8,1.8 0 1 0 8,9.8 A1.8,1.8 0 1 0 8,6.2 Z M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="最小化" ToolTip="最小化" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Data="M1.5,5 L8.5,5" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="最大化" ToolTip="最大化 / 还原" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIcon" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Data="M1.8,1.8 L8.2,1.8 L8.2,8.2 L1.8,8.2 Z" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="关闭" ToolTip="关闭窗口（不会关闭断网保护）" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center">
                <Grid Margin="22,20,22,20" MaxWidth="920" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="118" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="144" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="112" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/ProxyGauge.png" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="14,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ProxyGauge" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="监控代理连接、出口 IP 与浏览器隐私" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderIconButtonStyle}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="切换明暗外观" ToolTip="切换浅色 / 深色" Click="ThemeButton_Click">
                                <Grid Width="17" Height="17">
                                    <Path x:Name="ThemeSunIcon" Visibility="Collapsed" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M8.5,5.4 A3.1,3.1 0 1 0 8.5,11.6 A3.1,3.1 0 1 0 8.5,5.4 Z M8.5,0.8 V2.5 M8.5,14.5 V16.2 M0.8,8.5 H2.5 M14.5,8.5 H16.2 M3.05,3.05 L4.25,4.25 M12.75,12.75 L13.95,13.95 M13.95,3.05 L12.75,4.25 M4.25,12.75 L3.05,13.95" />
                                    <Path x:Name="ThemeMoonIcon" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M13.8,11.4 C12.6,12.4 11.1,13 9.4,13 C5.9,13 3,10.1 3,6.6 C3,4.8 3.7,3.2 4.9,2 C4.7,2.7 4.6,3.3 4.6,4 C4.6,8 7.8,11.2 11.8,11.2 C12.5,11.2 13.2,11.1 13.8,10.9 Z" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButtonStyle}" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" AutomationProperties.Name="刷新状态" ToolTip="刷新状态" IsEnabled="{Binding IsNotBusy}" Click="RefreshButton_Click">
                                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="248" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource DashboardCardButtonStyle}" Click="SettingsButton_Click" ToolTip="打开连接设置">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="62" Height="62" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                    <Viewbox Width="38" Height="38">
                                        <Canvas Width="48" Height="48">
                                            <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M14.3,10.8 C11.2,11.2 9.2,13.4 9.2,16.4 V31.6 C9.2,35.1 11.4,37.3 15,37.3 H33 C36.6,37.3 38.8,35.1 38.8,31.6 V16.4 C38.8,13 36.4,10.8 32.9,10.8 Z" />
                                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M16,5.8 V10.8 M24,4.6 V10.8 M32,5.8 V10.8 M16,37.3 V42.2 M24,37.3 V43.3 M32,37.3 V42.2 M4.7,18 H9.2 M3.6,25.2 H9.2 M4.7,32.4 H9.2 M38.8,17.7 H43.3 M38.8,25.2 H44.4 M38.8,32.4 H43.3" />
                                            <Path Fill="{DynamicResource AccentBrush}" Data="M17.5,17.2 H30.4 C32.2,17.2 33.5,18.5 33.5,20.3 V27.5 C33.5,29.5 32,30.9 30,30.9 H17.9 C15.8,30.9 14.4,29.5 14.4,27.4 V20.5 C14.4,18.5 15.7,17.2 17.5,17.2 Z" />
                                            <Path Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" Data="M20,24.2 H28" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock Text="代理状态" FontSize="11" FontWeight="Medium" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding OverallBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectionValue}" Foreground="{Binding OverallBrush}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConnectionDetail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Path Grid.Column="2" Width="7" Height="12" Stretch="Fill" Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="52" Height="52" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                    <Viewbox Width="31" Height="31">
                                        <Canvas Width="48" Height="48">
                                            <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M24,4.9 C29.5,8.5 34.3,10.3 41,11.7 V23.2 C41,33.6 35.3,40.2 24,43.2 C12.8,40.1 7,33.5 7,23.2 V11.7 C13.6,10.3 18.4,8.5 24,4.9 Z" />
                                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M15.2,24.2 L21.2,30.3 L33.4,17.3" />
                                            <Ellipse Canvas.Left="13.1" Canvas.Top="22.1" Width="4.2" Height="4.2" Fill="{DynamicResource AccentBrush}" />
                                            <Ellipse Canvas.Left="31.3" Canvas.Top="15.2" Width="4.2" Height="4.2" Fill="{DynamicResource AccentBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock Text="断网保护" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Text="{Binding GuardValue}" Foreground="{Binding GuardLevelBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding GuardEnabled, Mode=OneWay}" IsEnabled="{Binding CanChangeGuard}" Click="GuardButton_Click" ToolTip="开启或关闭断网保护" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                <Viewbox Width="41" Height="41">
                                    <Canvas Width="48" Height="48">
                                        <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M24.8,5.1 C13.2,4.8 5.3,12.8 5.1,24.4 C4.9,35.5 12.5,43 23.7,43.1 C35.2,43.2 42.9,35.4 42.9,23.9 C42.9,12.9 35.5,5.4 24.8,5.1 Z" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6.1,23.2 C14.5,25.1 33.8,25.6 41.9,23.1 M10.2,13.7 C16.7,16.2 30.8,16.2 37.6,13.6 M10.2,34.4 C16.9,32.2 31.4,32.2 37.9,34.5 M23.2,5.6 C14.4,16.2 16.1,33.8 23.8,42.3 M25.8,5.7 C33.8,16.7 31.5,33.5 24.7,42.3" />
                                        <Ellipse Canvas.Left="3.3" Canvas.Top="20.4" Width="5.6" Height="5.6" Fill="{DynamicResource AccentBrush}" />
                                        <Ellipse Canvas.Left="39.1" Canvas.Top="20.3" Width="5.6" Height="5.6" Fill="{DynamicResource AccentBrush}" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="当前出口" FontSize="11" FontWeight="Medium" />
                                <Button x:Name="CopyExitButton" Grid.Row="0" Style="{StaticResource HeaderIconButtonStyle}" Foreground="{DynamicResource MutedTextBrush}" Width="31" Height="31" HorizontalAlignment="Right" Margin="0,-6,-5,0" Click="CopyExitButton_Click" ToolTip="复制出口 IP" AutomationProperties.Name="复制出口 IP">
                                    <Viewbox Width="15" Height="15">
                                        <Canvas Width="18" Height="18">
                                            <Rectangle x:Name="CopyExitFront" Canvas.Left="6" Canvas.Top="5" Width="9" Height="10" RadiusX="1.6" RadiusY="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                                            <Path x:Name="CopyExitBack" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Data="M12,5 V3.5 C12,2.7 11.3,2 10.5,2 H3.5 C2.7,2 2,2.7 2,3.5 V10.5 C2,11.3 2.7,12 3.5,12 H6" />
                                            <Path x:Name="CopyExitCheckmark" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,9 L7,13 L15,4" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <TextBlock Grid.Row="1" Text="{Binding ExitAddress}" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding ExitNetwork}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Padding="9,4">
                                            <TextBlock x:Name="ExitLocationChip" Text="{Binding ExitLocation}" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Padding="9,4" Margin="7,0,0,0">
                                            <TextBlock x:Name="ExitNetworkTypeChip" Text="{Binding ExitNetworkType}" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource DashboardCardButtonStyle}" Click="IpPurityButton_Click" ToolTip="用默认浏览器查看 IP 风险与类型">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                    <Viewbox Width="31" Height="31"><Canvas Width="48" Height="48">
                                        <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M22.2,6.5 C12.9,6.3 6.7,12.4 6.5,21.8 C6.3,31 12.5,37 21.6,37.1 C25.6,37.1 29,36 31.6,33.8 L39.7,41.9 C41.1,43.3 43.2,43.3 44.5,42 C45.8,40.6 45.8,38.5 44.4,37.2 L36.2,29.4 C37.6,27.1 38.3,24.5 38.3,21.5 C38.3,12.5 31.9,6.7 22.2,6.5 Z" />
                                        <Ellipse Canvas.Left="14.8" Canvas.Top="14.5" Width="14.8" Height="14.8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" Data="M22.2,10.9 V15 M22.2,28.8 V32.9 M11.2,21.9 H15.3 M29.1,21.9 H33.2" />
                                        <Ellipse Canvas.Left="19.7" Canvas.Top="19.4" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                                    </Canvas></Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="IP 纯净度" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="查看 IP 风险与网络类型" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                                <Path Grid.Column="2" Width="7" Height="12" Stretch="Fill" Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource DashboardCardButtonStyle}" Click="PrivacyButton_Click" ToolTip="检查 DNS、WebRTC、IPv6 与浏览器指纹">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                    <Viewbox Width="31" Height="31"><Canvas Width="48" Height="48">
                                        <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.5,24.5 C8.7,16.1 15.1,12 24.1,12 C32.9,12 39.5,16.1 43.5,24.3 C39.2,32 32.8,36 24.2,36 C15.5,36 8.9,32.1 4.5,24.5 Z" />
                                        <Ellipse Canvas.Left="16.8" Canvas.Top="17.2" Width="14.7" Height="14" Fill="{DynamicResource AccentBrush}" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.3,8.2 L39.8,40 M8.3,8.2 L11.5,8 M8.3,8.2 L8.5,11.4 M39.8,40 L36.6,40.2 M39.8,40 L39.6,36.8" />
                                    </Canvas></Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="隐私泄露" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="检查 DNS、WebRTC 与 IPv6" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                                <Path Grid.Column="2" Width="7" Height="12" Stretch="Fill" Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource DashboardCardButtonStyle}" Click="SpeedButton_Click" ToolTip="测量真实浏览器路径的延迟与带宽">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSurfaceBrush}" />
                                    <Viewbox Width="31" Height="31"><Canvas Width="48" Height="48">
                                        <Path Fill="{DynamicResource AccentSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6.2,36.4 C5.2,33.4 4.8,30.9 5.1,27.9 C6.1,17.3 14.3,10 24.6,10.2 C34.9,10.4 42.9,18.3 42.9,29 C42.9,31.7 42.4,34.2 41.4,36.4 C32.9,39.8 14.6,39.9 6.2,36.4 Z" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" Data="M11.1,27.6 L8.2,27 M16.3,19.8 L14.1,17.5 M24.6,16.6 V13.6 M32.8,20.4 L35.1,18.3 M36.8,28.1 L39.8,27.6" />
                                        <Path Fill="{DynamicResource AccentBrush}" Data="M21.6,31.5 C20,30 19.9,27.8 21.4,26.3 L31.6,18.8 L24.8,30.4 C24,32.1 22.8,32.4 21.6,31.5 Z" />
                                        <Ellipse Canvas.Left="20.2" Canvas.Top="25.7" Width="6.6" Height="6.6" Fill="{DynamicResource AccentBrush}" />
                                    </Canvas></Viewbox>
                                </Grid>
