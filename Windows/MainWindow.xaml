<Window x:Class="ProxyGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge"
        Width="880"
        Height="700"
        MinWidth="880"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Icon="Assets/ProxyGauge.ico"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/ProxyGauge.ico" Width="24" Height="24" />
                        <TextBlock Text="ProxyGauge" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Background="#1F3045" CornerRadius="8" Padding="8,3" Margin="9,0,0,0">
                            <TextBlock Text="WINDOWS" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,5,4">
                        <Button Style="{StaticResource TitleButtonStyle}" ToolTip="设置" IsEnabled="{Binding IsNotBusy}" Click="SettingsButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M8,6.2 A1.8,1.8 0 1 0 8,9.8 A1.8,1.8 0 1 0 8,6.2 Z M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}" ToolTip="最小化" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.5,5 L8.5,5" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButtonStyle}" ToolTip="最大化 / 还原" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIcon" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.8,1.8 L8.2,1.8 L8.2,8.2 L1.8,8.2 Z" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButtonStyle}" ToolTip="关闭窗口（不会关闭系统保护）" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,22,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="192" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="212" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="68" Height="68" CornerRadius="17" Background="#EAF5FF" VerticalAlignment="Top">
                        <Image Source="Assets/ProxyGauge.ico" Width="62" Height="62" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="17,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding OverallBackground}" Margin="0,1,9,0">
                                <TextBlock Text="{Binding OverallMark}" Foreground="{Binding OverallBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Headline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="34,6,0,0" />
                        <TextBlock Text="{Binding LastUpdated}" Foreground="#62748A" FontSize="10" Margin="34,6,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource QuietButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="RefreshButton_Click"
                            ToolTip="刷新状态"
                            Padding="12,8"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                            <TextBlock Text="刷新" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="19,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Core.LevelBrush}" />
                            <TextBlock Text="核心" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="2" Background="{Binding Core.LevelBrush}" Opacity="0.42" Margin="13,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Port.LevelBrush}" />
                            <TextBlock Text="本地端口" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Height="2" Background="{Binding Route.LevelBrush}" Opacity="0.42" Margin="13,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Route.LevelBrush}" />
                            <TextBlock Text="流量入口" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="90" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Core.LevelBackground}">
                                    <TextBlock Text="{Binding Core.Marker}" Foreground="{Binding Core.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Core.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Core.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Core.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Port.LevelBackground}">
                                    <TextBlock Text="{Binding Port.Marker}" Foreground="{Binding Port.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Port.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Port.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Port.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Route.LevelBackground}">
                                    <TextBlock Text="{Binding Route.Marker}" Foreground="{Binding Route.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Route.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Route.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Route.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="11" Background="#252E3D">
                                    <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,-1,8,0">
                                <TextBlock Text="系统保护" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock Text="{Binding GuardValue}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Content="{Binding GuardButtonLabel}"
                                    IsEnabled="{Binding CanChangeGuard}"
                                    Click="GuardButton_Click"
                                    Padding="11,6"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding GuardDetail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="100" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#36516F" BorderThickness="1" CornerRadius="15" Padding="17">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="#233F5D">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,-1,14,0" VerticalAlignment="Center">
                                <TextBlock Text="链路检测" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Content="方案"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="PlanButton_Click"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding HealthButtonLabel}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="HealthButton_Click"
                                    VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="1"
                                         Grid.ColumnSpan="4"
                                         Height="3"
                                         Margin="0,10,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#26354A">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHealthCheckRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AdvancedSurfaceBrush}">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AdvancedBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,-1,14,0" VerticalAlignment="Center">
                                <TextBlock Text="IP 纯净度" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="在默认浏览器中人工复核 6 个网站" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Content="浏览器"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="AdvancedButton_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource RulesSurfaceBrush}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource RulesBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,-1,14,0" VerticalAlignment="Center">
                                <TextBlock Text="规则管理" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="12 条规则 · 版本 2026.08" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Content="管理"
                                    Click="RulesButton_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
