<Window x:Class="ProxyGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge"
        Width="680"
        Height="544"
        MinWidth="640"
        MinHeight="492"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Icon="Assets/ProxyGauge.ico"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/ProxyGauge.ico" Width="18" Height="18" />
                        <TextBlock Text="ProxyGauge" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,5,4">
                        <Button Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="设置" ToolTip="设置" IsEnabled="{Binding IsNotBusy}" Click="SettingsButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M8,6.2 A1.8,1.8 0 1 0 8,9.8 A1.8,1.8 0 1 0 8,6.2 Z M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="最小化" ToolTip="最小化" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.5,5 L8.5,5" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="最大化" ToolTip="最大化 / 还原" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIcon" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.8,1.8 L8.2,1.8 L8.2,8.2 L1.8,8.2 Z" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButtonStyle}" AutomationProperties.Name="关闭" ToolTip="关闭窗口（不会关闭系统保护）" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header: app icon + status dot/headline/detail + connection/refresh buttons -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/ProxyGauge.ico" Width="48" Height="48" />
                        <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding OverallBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Headline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="17,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderIconButtonStyle}" Foreground="{StaticResource AccentBrush}"
                                AutomationProperties.Name="连接设置" ToolTip="连接设置" IsEnabled="{Binding IsNotBusy}" Click="SettingsButton_Click">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconSliders}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Button Style="{StaticResource HeaderIconButtonStyle}" Foreground="{StaticResource AccentBrush}" Margin="7,0,0,0"
                                AutomationProperties.Name="刷新状态" ToolTip="刷新状态" IsEnabled="{Binding IsNotBusy}" Click="RefreshButton_Click">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconRefresh}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2x2 metric grid -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 代理核心 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="38" Height="38">
                                    <Border CornerRadius="11" Background="{Binding Core.LevelBrush}" Opacity="0.14" />
                                    <Border CornerRadius="11" BorderBrush="{Binding Core.LevelBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconCore}" Stroke="{Binding Core.LevelBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Core.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Core.Value}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Ellipse Width="7" Height="7" Fill="{Binding Core.LevelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 本地端口 -->
                    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="38" Height="38">
                                    <Border CornerRadius="11" Background="{Binding Port.LevelBrush}" Opacity="0.14" />
                                    <Border CornerRadius="11" BorderBrush="{Binding Port.LevelBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconPort}" Stroke="{Binding Port.LevelBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Port.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Port.Value}" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Ellipse Width="7" Height="7" Fill="{Binding Port.LevelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 流量入口 -->
                    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="38" Height="38">
                                    <Border CornerRadius="11" Background="{Binding Route.LevelBrush}" Opacity="0.14" />
                                    <Border CornerRadius="11" BorderBrush="{Binding Route.LevelBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconEntry}" Stroke="{Binding Route.LevelBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Route.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Route.Value}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Ellipse Width="7" Height="7" Fill="{Binding Route.LevelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Kill Switch（macOS 同款开关） -->
                    <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="38" Height="38">
                                    <Border CornerRadius="11" Background="{Binding GuardLevelBrush}" Opacity="0.14" />
                                    <Border CornerRadius="11" BorderBrush="{Binding GuardLevelBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconShield}" Stroke="{Binding GuardLevelBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Kill Switch" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Text="{Binding GuardValue}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Style="{StaticResource SwitchToggleStyle}"
                                      IsChecked="{Binding GuardEnabled, Mode=OneWay}"
                                      IsEnabled="{Binding CanChangeGuard}"
                                      Click="GuardButton_Click"
                                      ToolTip="开启或关闭防泄漏保护"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 链路检测 action card -->
                <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72">
                    <Grid Margin="12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12">
                            <Grid Width="30" Height="30">
                                <Border CornerRadius="15" Background="{StaticResource AccentBrush}" Opacity="0.14" />
                                <Border CornerRadius="15" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Opacity="0.13" />
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconHealth}" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="链路检测" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HealthDetail}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12">
                            <Button Style="{StaticResource PillButtonStyle}" Foreground="{StaticResource AccentBrush}" Width="76"
                                    AutomationProperties.Name="方案" IsEnabled="{Binding IsNotBusy}" Click="PlanButton_Click" ToolTip="调整链路检测方案">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconSliders}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="方案" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButtonStyle}" Foreground="{StaticResource AccentBrush}" Width="76" Margin="6,0,0,0"
                                    AutomationProperties.Name="检测" IsEnabled="{Binding IsNotBusy}" Click="HealthButton_Click" ToolTip="按当前方案检测代理链路">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconPlayFill}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HealthButtonLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ProgressBar Grid.Row="1"
                                     Height="3"
                                     Margin="0,0,0,10"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#26354A">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthCheckRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Border>

                <!-- IP 纯净度 + 规则管理 -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="30" Height="30">
                                    <Border CornerRadius="15" Background="{StaticResource AdvancedBrush}" Opacity="0.14" />
                                    <Border CornerRadius="15" BorderBrush="{StaticResource AdvancedBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconScope}" Stroke="{StaticResource AdvancedBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="IP 纯净度" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="在默认浏览器中人工复核 6 个网站" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource PillButtonStyle}" Foreground="{StaticResource AdvancedBrush}"
                                    AutomationProperties.Name="浏览器" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsNotBusy}" Click="AdvancedButton_Click" ToolTip="确认后在默认浏览器打开 IP 纯净度复核网站">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconOpen}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="浏览器" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" MinHeight="72" Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="30" Height="30">
                                    <Border CornerRadius="15" Background="{StaticResource RulesBrush}" Opacity="0.14" />
                                    <Border CornerRadius="15" BorderBrush="{StaticResource RulesBrush}" BorderThickness="1" Opacity="0.13" />
                                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconRules}" Stroke="{StaticResource RulesBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="规则管理" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="12 条 · 2026.08" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource PillButtonStyle}" Foreground="{StaticResource RulesBrush}"
                                    AutomationProperties.Name="管理" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="RulesButton_Click" ToolTip="管理可分享的 Mihomo / Clash Verge 规则包">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="管理" Foreground="{StaticResource RulesBrush}" VerticalAlignment="Center" />
                                    <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconChevron}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
