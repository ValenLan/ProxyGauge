<Window x:Class="PuffRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PuffRoute"
        Width="880"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/PuffRoute.ico"
        UseLayoutRounding="True">
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.38" Color="#050A11" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/PuffRoute.ico" Width="24" Height="24" />
                        <TextBlock Text="PuffRoute" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Background="#1F3045" CornerRadius="8" Padding="8,3" Margin="9,0,0,0">
                            <TextBlock Text="WINDOWS" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,5,4">
                        <Button Style="{StaticResource TitleButtonStyle}" Content="&#xE713;" ToolTip="设置" IsEnabled="{Binding IsNotBusy}" Click="SettingsButton_Click" />
                        <Button Style="{StaticResource TitleButtonStyle}" Content="&#xE921;" ToolTip="最小化" Click="MinimizeButton_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButtonStyle}" Content="&#xE8BB;" ToolTip="关闭" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,22,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="126" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="68" Height="68" CornerRadius="17" Background="#EAF5FF" VerticalAlignment="Top">
                        <Image Source="Assets/PuffRoute.ico" Width="62" Height="62" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="17,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding OverallBackground}" Margin="0,1,9,0">
                                <TextBlock Text="{Binding OverallMark}" Foreground="{Binding OverallBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Headline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="34,6,0,0" />
                        <TextBlock Text="{Binding LastUpdated}" Foreground="#62748A" FontSize="10" Margin="34,6,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource QuietButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="RefreshButton_Click"
                            ToolTip="刷新状态"
                            Padding="12,8"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                            <TextBlock Text="刷新" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="19,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Core.LevelBrush}" />
                            <TextBlock Text="核心" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="2" Background="{Binding Core.LevelBrush}" Opacity="0.42" Margin="13,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Port.LevelBrush}" />
                            <TextBlock Text="本地端口" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Height="2" Background="{Binding Route.LevelBrush}" Opacity="0.42" Margin="13,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Route.LevelBrush}" />
                            <TextBlock Text="流量入口" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Core.LevelBackground}">
                                    <TextBlock Text="{Binding Core.Marker}" Foreground="{Binding Core.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Core.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Core.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Core.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Port.LevelBackground}">
                                    <TextBlock Text="{Binding Port.Marker}" Foreground="{Binding Port.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Port.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Port.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Port.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="11" Background="{Binding Route.LevelBackground}">
                                    <TextBlock Text="{Binding Route.Marker}" Foreground="{Binding Route.LevelBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,-1,0,0">
                                    <TextBlock Text="{Binding Route.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Route.Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Route.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#36516F" BorderThickness="1" CornerRadius="15" Padding="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="#233F5D">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,-1,14,0" VerticalAlignment="Center">
                                <TextBlock Text="健康检查" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="验证出口 IP、AI 站点和外网连通性" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding HealthButtonLabel}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="HealthButton_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="#252E3D">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,-1,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="系统级保护" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="#2A3443" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                        <TextBlock Text="暂不提供" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="避免修改全局防火墙导致断网；Windows 版仅做只读检测。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
