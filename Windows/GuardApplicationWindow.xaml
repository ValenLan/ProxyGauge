<Window x:Class="ProxyGauge.GuardApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择代理应用" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" UseLayoutRounding="True">
    <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="22" Padding="24">
        <StackPanel>
            <TextBlock Text="选择代理应用" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ExplanationText" Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,10,0,16" />
            <ListBox x:Name="ApplicationList" MaxHeight="240" MinHeight="70"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ApplicationList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6" MaxWidth="445">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="只需选择实际联网的代理核心，无需填写端口。所选核心可直连；保护限当前用户，局域网保留。"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Grid Margin="0,16,0,0">
                <Button Content="选择其他程序…" Style="{StaticResource QuietButtonStyle}"
                        HorizontalAlignment="Left" Click="Browse_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource QuietButtonStyle}" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="EnableButton" Content="选择并开启" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="False" Margin="8,0,0,0" Click="Enable_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
