<Application x:Class="ProxyGauge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
          ThemeService replaces these color tokens before the first window opens and
          whenever Windows changes appearance. Brushes keep DynamicResource bindings
          so every open window updates without being recreated.
        -->
        <Color x:Key="CanvasColor">#242424</Color>
        <Color x:Key="SurfaceColor">#1C1C1C</Color>
        <Color x:Key="SurfaceRaisedColor">#2A2A2A</Color>
        <Color x:Key="SurfaceSubtleColor">#202020</Color>
        <Color x:Key="ControlColor">#2C2C2E</Color>
        <Color x:Key="ControlHoverColor">#3A3A3C</Color>
        <Color x:Key="FieldColor">#141414</Color>
        <Color x:Key="BorderColor">#14FFFFFF</Color>
        <Color x:Key="TextColor">#ECECEC</Color>
        <Color x:Key="MutedTextColor">#9C9CA1</Color>
        <Color x:Key="SubtleTextColor">#62748A</Color>
        <Color x:Key="AccentColor">#218CFF</Color>
        <Color x:Key="AccentStrongColor">#0A84FF</Color>
        <Color x:Key="AccentHoverColor">#3D9DFF</Color>
        <Color x:Key="AccentFocusColor">#D9EBFF</Color>
        <Color x:Key="OnAccentColor">#FFFFFF</Color>
        <Color x:Key="AccentSurfaceColor">#20375A</Color>
        <Color x:Key="AccentTintColor">#223D76AD</Color>
        <Color x:Key="SuccessColor">#33C759</Color>
        <Color x:Key="WarningColor">#FF9F0A</Color>
        <Color x:Key="ErrorColor">#FF453A</Color>
        <Color x:Key="IdleColor">#8E8E93</Color>
        <Color x:Key="SuccessBackgroundColor">#2433C759</Color>
        <Color x:Key="WarningBackgroundColor">#24FF9F0A</Color>
        <Color x:Key="ErrorBackgroundColor">#24FF453A</Color>
        <Color x:Key="IdleBackgroundColor">#248E8E93</Color>
        <Color x:Key="RulesColor">#8A6BF5</Color>
        <Color x:Key="RulesSurfaceColor">#262040</Color>
        <Color x:Key="AdvancedColor">#33B8D1</Color>
        <Color x:Key="AdvancedSurfaceColor">#1D3038</Color>
        <Color x:Key="SwitchTrackColor">#3A3A3C</Color>
        <Color x:Key="SwitchThumbColor">#F5F5F7</Color>
        <Color x:Key="ProgressTrackColor">#26354A</Color>

        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{DynamicResource SurfaceSubtleColor}" />
        <SolidColorBrush x:Key="ControlBrush" Color="{DynamicResource ControlColor}" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="{DynamicResource SubtleTextColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="{DynamicResource AccentStrongColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
        <SolidColorBrush x:Key="AccentFocusBrush" Color="{DynamicResource AccentFocusColor}" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
        <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{DynamicResource AccentSurfaceColor}" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="{DynamicResource AccentTintColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
        <SolidColorBrush x:Key="IdleBrush" Color="{DynamicResource IdleColor}" />
        <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{DynamicResource SuccessBackgroundColor}" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{DynamicResource WarningBackgroundColor}" />
        <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{DynamicResource ErrorBackgroundColor}" />
        <SolidColorBrush x:Key="IdleBackgroundBrush" Color="{DynamicResource IdleBackgroundColor}" />
        <SolidColorBrush x:Key="RulesBrush" Color="{DynamicResource RulesColor}" />
        <SolidColorBrush x:Key="RulesSurfaceBrush" Color="{DynamicResource RulesSurfaceColor}" />
        <SolidColorBrush x:Key="AdvancedBrush" Color="{DynamicResource AdvancedColor}" />
        <SolidColorBrush x:Key="AdvancedSurfaceBrush" Color="{DynamicResource AdvancedSurfaceColor}" />
        <SolidColorBrush x:Key="SwitchTrackBrush" Color="{DynamicResource SwitchTrackColor}" />
        <SolidColorBrush x:Key="SwitchThumbBrush" Color="{DynamicResource SwitchThumbColor}" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="{DynamicResource ProgressTrackColor}" />

        <!-- Vector glyphs mirroring the SF Symbols used by the macOS app -->
        <StreamGeometry x:Key="IconCore">M4.5,4.5 h7 v7 h-7 Z M6.8,6.8 h2.4 v2.4 h-2.4 Z M6,2 v2.5 M10,2 v2.5 M6,11.5 v2.5 M10,11.5 v2.5 M2,6 h2.5 M2,10 h2.5 M11.5,6 h2.5 M11.5,10 h2.5</StreamGeometry>
        <StreamGeometry x:Key="IconPort">M1.5,6.5 h4 v3 h-4 Z M10.5,6.5 h4 v3 h-4 Z M5.5,8 h5 M3.5,5.5 v5 M12.5,5.5 v5</StreamGeometry>
        <StreamGeometry x:Key="IconEntry">M8,2.5 L8,7.5 M8,7.5 L4,13.5 M8,7.5 L12,13.5 M4,10.5 L4,13.5 L7,13.5 M12,10.5 L12,13.5 L9,13.5</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M8,2 L13,4 V7.8 C13,11 11,13.6 8,14.6 C5,13.6 3,11 3,7.8 V4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconHealth">M1.5,8 h2.8 l1.4,-4 l2.8,8 l1.4,-4 h4.6</StreamGeometry>
        <StreamGeometry x:Key="IconScope">M8,2.5 a5.5,5.5 0 1 0 0.01,0 Z M8,1 v2 M8,13 v2 M1,8 h2 M13,8 h2</StreamGeometry>
        <StreamGeometry x:Key="IconRules">M6.5,4.5 h7 M6.5,8 h7 M6.5,11.5 h7 M3.5,4.5 l0.01,0 M3.5,8 l0.01,0 M3.5,11.5 l0.01,0</StreamGeometry>
        <StreamGeometry x:Key="IconSliders">M1.5,4.2 h6 M10.8,4.2 h3.7 M1.5,8 h3.2 M8.2,8 h6.3 M1.5,11.8 h6 M10.8,11.8 h3.7 M8.9,3 a1.4,1.4 0 1 0 0.01,0 Z M6.4,6.8 a1.4,1.4 0 1 0 0.01,0 Z M8.9,10.6 a1.4,1.4 0 1 0 0.01,0 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M13.5,8 a5.5,5.5 0 1 1 -1.6,-3.9 M13.7,1.8 v3 h-3</StreamGeometry>
        <StreamGeometry x:Key="IconOpen">M4.5,11.5 L11.5,4.5 M6,4.5 h5.5 v5.5</StreamGeometry>
        <StreamGeometry x:Key="IconChevron">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>
        <StreamGeometry x:Key="IconPlayFill">M4.5,2.8 L12,8 L4.5,13.2 Z</StreamGeometry>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- 34x34 rounded-square ghost button tinted by its own Foreground (macOS header buttons) -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FillBorder" CornerRadius="9" Background="{TemplateBinding Foreground}" Opacity="0.09" />
                            <Border x:Name="StrokeBorder" CornerRadius="9" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0.12" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBorder" Property="Opacity" Value="0.17" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBorder" Property="Opacity" Value="0.24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 28-high ghost pill button tinted by its own Foreground (macOS card action pills) -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FillBorder" CornerRadius="7" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                            <Border x:Name="StrokeBorder" CornerRadius="7" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0.30" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBorder" Property="Opacity" Value="0.24" />
                                <Setter TargetName="StrokeBorder" Property="Opacity" Value="0.58" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBorder" Property="Opacity" Value="0.30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style small switch -->
        <Style x:Key="SwitchToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource SwitchTrackBrush}" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource SwitchThumbBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Application.Resources>
</Application>
