<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProxyGauge</AssemblyName>
    <RootNamespace>ProxyGauge</RootNamespace>
    <ApplicationIcon>Assets\ProxyGauge.ico</ApplicationIcon>
    <Version>1.5.4</Version>
    <AssemblyVersion>1.5.4.0</AssemblyVersion>
    <FileVersion>1.5.4.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ProxyGauge.ico" />
    <EmbeddedResource Include="..\Rules\ProxyGauge-Merge.yaml"
                      Link="Rules\ProxyGauge-Merge.yaml"
                      LogicalName="ProxyGauge.Rules.ProxyGauge-Merge.yaml" />
  </ItemGroup>
</Project>
