<Window x:Class="ProxyGauge.HealthReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge 链路检测"
        Width="720"
        Height="640"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/ProxyGauge.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="代理链路检测" FontSize="13" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Margin="0,4,5,4" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                              Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" Background="{Binding StatusBackground}">
                        <TextBlock Text="{Binding StatusMark}" Foreground="{Binding StatusBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,-2,0,0">
                        <TextBlock Text="{Binding Headline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{Binding ScoreBackground}" BorderBrush="{Binding ScoreBrush}" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="14,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="/100" Foreground="{Binding ScoreBrush}" FontSize="10" Margin="2,9,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ScoreLabel}" Foreground="{Binding ScoreBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="13,9" Margin="0,17,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CheckedAtText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding PassedText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding FailedText}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="关键链路加权；IP 纯净度复核与账户状态不计分"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="2,10,0,10" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Report.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="14"
                                        Margin="0,0,0,11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="1,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="ResultDot" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ErrorBackgroundBrush}" VerticalAlignment="Top">
                                                            <TextBlock x:Name="ResultMark" Text="{Binding Mark}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="7,-1,0,0">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="DetailText" Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            <Button x:Name="OpenLinkButton"
                                                                    Content="在浏览器打开"
                                                                    Tag="{Binding Detail}"
                                                                    Style="{StaticResource QuietButtonStyle}"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,5,0,0"
                                                                    Padding="10,4"
                                                                    Visibility="Collapsed"
                                                                    Click="OpenLinkButton_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                            <Setter TargetName="ResultDot" Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                            <Setter TargetName="ResultMark" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
                                                            <Setter TargetName="ResultDot" Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                            <Setter TargetName="ResultMark" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="Idle">
                                                            <Setter TargetName="ResultDot" Property="Background" Value="{DynamicResource IdleBackgroundBrush}" />
                                                            <Setter TargetName="ResultMark" Property="Foreground" Value="{DynamicResource IdleBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                            <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="OpenLinkButton" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="5">
                    <Button Style="{StaticResource QuietButtonStyle}" Content="复制结果" Width="96" HorizontalAlignment="Left" Click="CopyButton_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="完成" Width="88" HorizontalAlignment="Right" Click="CloseButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
