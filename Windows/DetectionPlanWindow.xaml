<Window x:Class="ProxyGauge.DetectionPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge 检测方案"
        Width="610"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/ProxyGauge.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="链路检测方案" FontSize="13" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Margin="0,4,5,4" Click="CancelButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                              Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="从通用检测开始" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="仅在确实配置了独立入口和策略组时启用额外出口。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="额外出口检测" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="增加策略组、域名规则和第二个真实出口验证" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="EnableCheckBox"
                                  Grid.Column="1"
                                  Content="启用"
                                  Foreground="{StaticResource TextBrush}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Checked="EnableCheckBox_Changed"
                                  Unchecked="EnableCheckBox_Changed" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="0,17,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SecondaryFields">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="方案名称" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                                <TextBox x:Name="LabelTextBox" Style="{StaticResource FieldStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="额外策略组" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                                <TextBox x:Name="SecondaryGroupTextBox" Style="{StaticResource FieldStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="额外入口（仅回环地址）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                                <TextBox x:Name="SecondaryHostTextBox" Style="{StaticResource FieldStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                                <TextBox x:Name="SecondaryPortTextBox" Style="{StaticResource FieldStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="默认策略组" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                            <TextBox x:Name="DefaultGroupTextBox" Style="{StaticResource FieldStyle}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="目标域名（英文逗号分隔）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                            <TextBox x:Name="DomainsTextBox" Style="{StaticResource FieldStyle}" TextWrapping="Wrap" Height="62" AcceptsReturn="False" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="额外出口期望 IP（可选）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                            <TextBox x:Name="ExpectedSecondaryIpTextBox" Style="{StaticResource FieldStyle}" />
                        </StackPanel>

                        <Border Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,17,0,0">
                            <TextBlock Text="ProxyGauge 只读取 Mihomo 控制接口中的策略状态，不保存节点列表、订阅或原始配置。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="3"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="11"
                           Margin="2,10,0,10"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButtonStyle}" Content="取消" Width="82" Click="CancelButton_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存方案" Width="104" Margin="10,0,0,0" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
