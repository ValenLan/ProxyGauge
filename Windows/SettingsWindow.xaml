<Window x:Class="ProxyGauge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge 设置"
        Width="510"
        Height="670"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/ProxyGauge.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ProxyChoiceStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="⌄" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" Padding="9,8"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" /></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value></Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="连接设置" FontSize="13" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Margin="0,4,5,4" Click="CancelButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                              Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="HeaderText" Text="本地代理入口" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntroText" Text="选择用于断网保护的代理核心；端口仅用于链路检测。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiscoveryStatusText"
                                   Text="可自动检查本地控制接口、系统代理和常用回环端口。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button x:Name="DiscoverButton"
                                Grid.Column="1"
                                Style="{StaticResource QuietButtonStyle}"
                                Content="自动检测"
                                Padding="12,7"
                                Click="DiscoverButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主机地址" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="HostTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="端口" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="PortTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="期望出口 IP（可选）" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="ExpectedIpTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="超时（秒）" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="TimeoutTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="断网保护 · 放行的代理核心" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProxyApplicationComboBox" Style="{StaticResource ProxyChoiceStyle}" DisplayMemberPath="Label" MinHeight="32" Margin="0,10,0,0"
                                  ToolTip="请选择实际处理网络流量的核心进程，不要选择浏览器或仅负责界面的启动器。" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="选择程序…" Style="{StaticResource QuietButtonStyle}" Padding="10,5" Click="BrowseProxyApplication_Click" />
                            <Button Content="刷新进程" Style="{StaticResource QuietButtonStyle}" Padding="10,5" Margin="8,0,0,0" Click="RefreshProxyApplications_Click" />
                        </StackPanel>
                        <TextBlock Text="默认自动识别运行中的 Clash / Mihomo、iKuuu 等核心，无需填写端口。也可手动固定一个程序。信任核心的 DIRECT；退出核心后仍拦截当前用户的公网直连，局域网保留。系统服务和其他用户不在本版保护范围。"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="1,1,0,0" />
                        <TextBlock Grid.Column="1" Text="配置仅保存在当前 Windows 用户的 AppData 目录，不会上传。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,86,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="软件更新" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Content="检查更新" Padding="12,7" Click="CheckUpdateButton_Click" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="5"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="11"
                           Margin="2,158,0,0"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButtonStyle}" Content="取消" Width="82" Click="CancelButton_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存设置" Width="104" Margin="10,0,0,0" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
