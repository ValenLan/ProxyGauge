<Window x:Class="ProxyGauge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProxyGauge 设置"
        Width="510"
        Height="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/ProxyGauge.ico"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="连接设置" FontSize="13" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Margin="0,4,5,4" Click="CancelButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                              Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="HeaderText" Text="本地代理入口" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntroText" Text="自动识别 Clash Verge 或 Mihomo 的 mixed 监听地址。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiscoveryStatusText"
                                   Text="可自动检查本地控制接口、系统代理和常用回环端口。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button x:Name="DiscoverButton"
                                Grid.Column="1"
                                Style="{StaticResource QuietButtonStyle}"
                                Content="自动检测"
                                Padding="12,7"
                                Click="DiscoverButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主机地址" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="HostTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="端口" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="PortTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="期望出口 IP（可选）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="ExpectedIpTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="超时（秒）" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,0,0,7" />
                        <TextBox x:Name="TimeoutTextBox" Style="{StaticResource FieldStyle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Background="#121D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="1,1,0,0" />
                        <TextBlock Grid.Column="1" Text="配置仅保存在当前 Windows 用户的 AppData 目录，不会上传。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="4"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="11"
                           Margin="2,75,0,0"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButtonStyle}" Content="取消" Width="82" Click="CancelButton_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存设置" Width="104" Margin="10,0,0,0" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
