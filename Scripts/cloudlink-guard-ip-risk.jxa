ObjC.import("Foundation");

function readJSON(path) {
    if (!path) return {};
    try {
        const data = $.NSData.dataWithContentsOfFile(path);
        if (!data || Number(data.length) === 0) return {};
        const error = Ref();
        const object = $.NSJSONSerialization.JSONObjectWithDataOptionsError(data, 0, error);
        const unwrapped = object ? ObjC.deepUnwrap(object) : null;
        return unwrapped && typeof unwrapped === "object" ? unwrapped : {};
    } catch (_) {
        return {};
    }
}

function valueAt(object, path) {
    let current = object;
    for (const key of path) {
        if (current === null || current === undefined || typeof current !== "object") return null;
        current = current[key];
    }
    return current === undefined ? null : current;
}

function text(value) {
    return value === null || value === undefined || value === "" ? null : String(value);
}

function riskLabel(score) {
    if (score <= 25) return "低";
    if (score <= 50) return "中";
    if (score <= 75) return "高";
    return "很高";
}

function networkTypeLabel(value) {
    if (!value) return null;
    const normalized = String(value).toLowerCase();
    const labels = {
        "nsp": "ISP / 网络服务商",
        "cable/dsl/isp": "ISP / 宽带运营商",
        "isp": "ISP / 网络服务商",
        "business": "商业网络",
        "enterprise": "企业网络",
        "hosting": "托管 / 数据中心",
        "residential": "住宅宽带",
        "wireless": "移动 / 无线网络",
        "educational/research": "教育 / 研究网络",
        "government": "政府网络",
        "content": "内容网络"
    };
    return labels[normalized] || String(value);
}

function run(argv) {
    if (argv[0] === "extract-asn") {
        const ipDocument = readJSON(argv[1]);
        const proxyDocument = readJSON(argv[2]);
        const address = argv[3] || "";
        const proxyResult = proxyDocument[address] || {};
        const rawASN = text(valueAt(ipDocument, ["asn", "asn"]))
            || text(ipDocument.asn_num)
            || text(valueAt(proxyResult, ["network", "asn"]))
            || "";
        return rawASN.toUpperCase().startsWith("AS") ? rawASN.slice(2) : rawASN;
    }

    const ipapi = readJSON(argv[0]);
    const proxycheck = readJSON(argv[1]);
    const peeringdb = readJSON(argv[2]);
    const address = argv[3] || "";
    const proxyResult = proxycheck[address] || {};
    const detections = proxyResult.detections || {};
    const network = proxyResult.network || {};
    const asn = ipapi.asn || {};
    const company = ipapi.company || {};
    const location = ipapi.location || {};
    const peeringRecord = peeringdb && Array.isArray(peeringdb.data) && peeringdb.data.length > 0
        ? peeringdb.data[0]
        : {};
    const lines = [];

    lines.push("  ℹ️ 数据源: ipapi.is / proxycheck.io / PeeringDB（前两者查询 IP；PeeringDB 查询 ASN）");

    const asnNumber = text(asn.asn) || text(ipapi.asn_num) || text(network.asn);
    const organisation = text(asn.org) || text(ipapi.asn_org) || text(network.provider)
        || text(company.name) || text(ipapi.company_name);
    if (asnNumber || organisation) {
        const normalizedASN = asnNumber && !asnNumber.toUpperCase().startsWith("AS") ? `AS${asnNumber}` : asnNumber;
        lines.push(`  ℹ️ 网络归属: ${[normalizedASN, organisation].filter(Boolean).join(" · ")}`);
    }

    const peeringTypes = Array.isArray(peeringRecord.info_types) ? peeringRecord.info_types : [];
    const asnType = text(peeringTypes[0]) || text(peeringRecord.info_type) || text(asn.type);
    if (asnType) {
        const source = Object.keys(peeringRecord).length > 0 ? "PeeringDB" : "ipapi.is";
        lines.push(`  ℹ️ ASN 属性: ${networkTypeLabel(asnType)}（${source}）`);
    }

    const allocationType = text(network.type) || text(company.type);
    if (allocationType) {
        const source = text(network.type) ? "proxycheck.io" : "ipapi.is";
        lines.push(`  ℹ️ IP 段用途: ${networkTypeLabel(allocationType)}（${source}）`);
    }

    const country = text(location.country) || text(ipapi.cc);
    const city = text(location.city);
    if (country || city) {
        lines.push(`  ℹ️ 地区: ${[country, city].filter(Boolean).join(" ")}`);
    }

    const risk = Number(detections.risk);
    const confidence = Number(detections.confidence);
    if (Number.isFinite(risk)) {
        const marker = risk <= 25 ? "✅" : "⚠️";
        const confidenceText = Number.isFinite(confidence) ? ` · 置信度 ${confidence}%` : "";
        lines.push(`  ${marker} proxycheck 风险分: ${risk}/100（${riskLabel(risk)}）${confidenceText}`);
    } else {
        lines.push("  ℹ️ proxycheck 风险分暂不可用（可能已限流）");
    }

    const flags = [];
    const flagMap = [
        ["hosting", "数据中心"],
        ["proxy", "代理出口"],
        ["vpn", "VPN"],
        ["tor", "Tor"],
        ["compromised", "疑似被入侵"],
        ["scraper", "爬虫"],
        ["anonymous", "匿名网络"]
    ];
    for (const [key, label] of flagMap) {
        if (detections[key] === true) flags.push(label);
    }
    if (ipapi.is_abuser === true && !flags.includes("滥用记录")) flags.push("滥用记录");
    if (ipapi.is_vpn === true && !flags.includes("VPN")) flags.push("VPN");
    if (ipapi.is_proxy === true && !flags.includes("代理出口")) flags.push("代理出口");
    if (ipapi.is_tor === true && !flags.includes("Tor")) flags.push("Tor");
    if (ipapi.is_datacenter === true && !flags.includes("数据中心")) flags.push("数据中心");

    if (flags.length > 0) {
        lines.push(`  ⚠️ 地址风险标签: ${flags.join(" / ")}`);
    } else if (Object.keys(detections).length > 0 || Object.keys(ipapi).length > 0) {
        lines.push("  ✅ 地址风险标签: 未发现代理、VPN、Tor 或滥用记录");
    }

    const companyScore = text(company.abuser_score);
    const asnScore = text(asn.abuser_score);
    if (companyScore || asnScore) {
        const scores = [];
        if (companyScore) scores.push(`组织 ${companyScore}`);
        if (asnScore) scores.push(`ASN ${asnScore}`);
        lines.push(`  ℹ️ 滥用指标: ${scores.join(" · ")}`);
    }

    if (lines.length === 1) {
        lines.push("  ℹ️ IP 风险画像暂不可用；不影响代理链路检查结果");
    }
    lines.push("  ℹ️ 第三方 IP 情报仅供参考，不代表浏览器环境或具体服务可用性");
    return lines.join("\n");
}
