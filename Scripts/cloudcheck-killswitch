#!/bin/bash
# cloudcheck-killswitch — PF 独立 anchor 的安装与防泄漏开关
#   install                      自动发现物理接口并安装内置规则（保持关闭）
#   on                           必要时安装/恢复内置规则，然后开启保护
#   off                          清空专属 anchor 并释放本工具的 reference
#   status                       检查 PF 与 anchor 的真实状态

SCRIPT_DIR=$(/usr/bin/dirname "$0")
TEST_ROOT="${CLOUDCHECK_KILLSWITCH_TEST_ROOT:-}"

if [ -n "$TEST_ROOT" ]; then
  case "$TEST_ROOT" in
    /tmp/cloudcheck-killswitch-test.*) ;;
    *) echo "❌ 非法的 Kill Switch 测试目录"; exit 2 ;;
  esac
  if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    echo "❌ 测试模式禁止以 root 运行"
    exit 2
  fi
  PFCTL="${CLOUDCHECK_KILLSWITCH_TEST_PFCTL:-/sbin/pfctl}"
  MAIN_CONF="$TEST_ROOT/etc/pf.conf"
  ANCHOR_DIR="$TEST_ROOT/etc/pf.anchors"
  TOKEN_FILE="$TEST_ROOT/var/run/cloudcheck-killswitch.pf-token"
  PF_TEMPLATE="${CLOUDCHECK_KILLSWITCH_TEST_TEMPLATE:-$SCRIPT_DIR/../PF/cloudcheck.conf.template}"
  PERSIST_HELPER="$TEST_ROOT/Library/PrivilegedHelperTools/com.valenlan.cloudcheck.killswitch"
  PERSIST_PLIST="$TEST_ROOT/Library/LaunchDaemons/com.valenlan.cloudcheck.killswitch.plist"
  PERSIST_STATE_DIR="$TEST_ROOT/var/db/cloudcheck"
  TEST_MODE=1
else
  PFCTL=/sbin/pfctl
  MAIN_CONF=/etc/pf.conf
  ANCHOR_DIR=/etc/pf.anchors
  TOKEN_FILE=/var/run/cloudcheck-killswitch.pf-token
  PF_TEMPLATE="$SCRIPT_DIR/cloudcheck.conf.template"
  PERSIST_HELPER=/Library/PrivilegedHelperTools/com.valenlan.cloudcheck.killswitch
  PERSIST_PLIST=/Library/LaunchDaemons/com.valenlan.cloudcheck.killswitch.plist
  PERSIST_STATE_DIR=/var/db/cloudcheck
  TEST_MODE=0
fi

PERSIST_LABEL=com.valenlan.cloudcheck.killswitch
PERSIST_MARKER="$PERSIST_STATE_DIR/enabled"

ANCHOR=cloudcheck
ANCHOR_CONF="$ANCHOR_DIR/cloudcheck"

console_home() {
  local console_user
  console_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
  if [ -n "$console_user" ] && [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    /usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}'
  fi
}

if [ "$TEST_MODE" -eq 0 ] && [ ! -r "$PF_TEMPLATE" ]; then
  if [ -r "$SCRIPT_DIR/../PF/cloudcheck.conf.template" ]; then
    PF_TEMPLATE="$SCRIPT_DIR/../PF/cloudcheck.conf.template"
  else
    CONSOLE_HOME=$(console_home)
    if [ -n "$CONSOLE_HOME" ] && [ -r "$CONSOLE_HOME/.local/share/cloudcheck/cloudcheck.conf.template" ]; then
      PF_TEMPLATE="$CONSOLE_HOME/.local/share/cloudcheck/cloudcheck.conf.template"
    fi
  fi
fi

ACTION="${1:-status}"
BOOTSTRAP_DEFAULT=0

# A much older installation owns the generic "killswitch" anchor. Never
# install a second rule set beside it automatically; the bundled root helper
# operates the existing root-owned anchor directly.
if /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"killswitch"' "$MAIN_CONF" 2>/dev/null; then
  if [ "$ACTION" = "install" ]; then
    echo "❌ 检测到旧版 killswitch anchor，未叠加第二套 PF 规则"
    echo "请先单独迁移旧规则，再重新配置 CloudCheck"
    exit 1
  fi
fi

# The switch controls an already installed rule set. If a cleanup or migration
# removed only its /etc/pf.conf entry, recover that entry without regenerating
# the anchor or asking the user for server/network parameters again.
if [ "$ACTION" = "on" ] && ! /usr/bin/grep -qE \
  '^[[:space:]]*anchor[[:space:]]+"(cloudcheck|cloudlink-guard|cloudroute|puffroute|killswitch)"' \
  "$MAIN_CONF" 2>/dev/null; then
  existing_count=0
  existing_anchor=""
  for candidate_anchor in cloudcheck cloudlink-guard cloudroute puffroute killswitch; do
    if [ -r "$ANCHOR_DIR/$candidate_anchor" ]; then
      existing_count=$((existing_count + 1))
      existing_anchor="$candidate_anchor"
    fi
  done

  if [ "$existing_count" -eq 0 ]; then
    BOOTSTRAP_DEFAULT=1
  elif [ "$existing_count" -ne 1 ]; then
    echo "❌ 检测到多套未注册的 Kill Switch 规则，为避免启用错误规则，未做改动"
    exit 1
  else
    ANCHOR="$existing_anchor"
    ANCHOR_CONF="$ANCHOR_DIR/$existing_anchor"
    case "$existing_anchor" in
      cloudcheck) TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/cloudcheck-killswitch.pf-token" ;;
      cloudlink-guard) TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/cloudlink-guard-killswitch.pf-token" ;;
      cloudroute) TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/cloudroute-killswitch.pf-token" ;;
      puffroute) TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/puffroute-killswitch.pf-token" ;;
      killswitch) TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/proxy-tools-killswitch.pf-token" ;;
    esac
  fi
fi

# Preserve previous migrations: Proxy Tools -> PuffRoute -> CloudRoute ->
# CloudLinkGuard -> CloudCheck. A configured predecessor remains authoritative.
if ! /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"cloudcheck"' "$MAIN_CONF" 2>/dev/null; then
  if /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"cloudlink-guard"' "$MAIN_CONF" 2>/dev/null \
    && [ -r "$ANCHOR_DIR/cloudlink-guard" ]; then
    ANCHOR=cloudlink-guard
    ANCHOR_CONF="$ANCHOR_DIR/cloudlink-guard"
    TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/cloudlink-guard-killswitch.pf-token"
  elif /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"cloudroute"' "$MAIN_CONF" 2>/dev/null \
    && [ -r "$ANCHOR_DIR/cloudroute" ]; then
    ANCHOR=cloudroute
    ANCHOR_CONF="$ANCHOR_DIR/cloudroute"
    TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/cloudroute-killswitch.pf-token"
  elif /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"puffroute"' "$MAIN_CONF" 2>/dev/null \
    && [ -r "$ANCHOR_DIR/puffroute" ]; then
    ANCHOR=puffroute
    ANCHOR_CONF="$ANCHOR_DIR/puffroute"
    TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/puffroute-killswitch.pf-token"
  elif /usr/bin/grep -qE '^[[:space:]]*anchor[[:space:]]+"killswitch"' "$MAIN_CONF" 2>/dev/null \
    && [ -r "$ANCHOR_DIR/killswitch" ]; then
    ANCHOR=killswitch
    ANCHOR_CONF="$ANCHOR_DIR/killswitch"
    TOKEN_FILE="${TEST_ROOT:+$TEST_ROOT}/var/run/proxy-tools-killswitch.pf-token"
  fi
fi

if [ "$TEST_MODE" -eq 0 ] && [ "$(/usr/bin/id -u)" -ne 0 ]; then
  exec /usr/bin/sudo "$0" "$@"
fi

valid_interfaces() {
  local interfaces interface_name count
  local -a interface_names
  interfaces="$1"
  case "$interfaces" in
    *$'\n'*|*$'\r'*) return 1 ;;
  esac
  if ! /usr/bin/printf '%s\n' "$interfaces" | /usr/bin/grep -qE '^((en|bridge|ppp)[0-9]+)([[:space:]]+(en|bridge|ppp)[0-9]+)*$'; then
    return 1
  fi
  read -r -a interface_names <<EOF
$interfaces
EOF
  count=0
  for interface_name in "${interface_names[@]}"; do
    case "$interface_name" in
      en[0-9]*|bridge[0-9]*|ppp[0-9]*)
        /usr/bin/printf '%s\n' "$interface_name" | /usr/bin/grep -qE '^(en|bridge|ppp)[0-9]+$' || return 1
        ;;
      *) return 1 ;;
    esac
    count=$((count + 1))
  done
  [ "$count" -gt 0 ]
}

detect_physical_interfaces() {
  local interfaces default_interface

  if [ "$TEST_MODE" -eq 1 ] && [ -n "${CLOUDCHECK_KILLSWITCH_TEST_INTERFACES:-}" ]; then
    interfaces="$CLOUDCHECK_KILLSWITCH_TEST_INTERFACES"
  else
    interfaces=$(/sbin/ifconfig -l 2>/dev/null \
      | /usr/bin/tr ' ' '\n' \
      | /usr/bin/grep -E '^(en|bridge|ppp)[0-9]+$' \
      | /usr/bin/sort -u \
      | /usr/bin/paste -sd ' ' -)
    if [ -z "$interfaces" ]; then
      default_interface=$(/sbin/route -n get default 2>/dev/null \
        | /usr/bin/awk '/interface:/ { print $2; exit }')
      interfaces="$default_interface"
    fi
  fi

  valid_interfaces "$interfaces" || return 1
  /usr/bin/printf '%s\n' "$interfaces"
}

proxy_core_runs_as_root() {
  local pids pid uid found
  [ "$TEST_MODE" -eq 1 ] && return 0

  pids=$(/usr/bin/pgrep -x verge-mihomo 2>/dev/null || true)
  found=0
  for pid in $pids; do
    uid=$(/bin/ps -o uid= -p "$pid" 2>/dev/null | /usr/bin/tr -d '[:space:]')
    [ -n "$uid" ] || continue
    found=1
    if [ "$uid" != "0" ]; then
      echo "❌ 当前代理核心不是以系统服务运行，未开启 Kill Switch"
      return 1
    fi
  done
  if [ "$found" -ne 1 ]; then
    echo "❌ 未找到正在运行的代理核心，未开启 Kill Switch"
    return 1
  fi
}

install_config_file() {
  local source destination
  source="$1"
  destination="$2"
  if [ "$TEST_MODE" -eq 1 ]; then
    /usr/bin/install -m 644 "$source" "$destination"
  else
    /usr/bin/install -o root -g wheel -m 644 "$source" "$destination"
  fi
}

install_private_file() {
  local source destination mode
  source="$1"
  destination="$2"
  mode="$3"
  if [ "$TEST_MODE" -eq 1 ]; then
    /usr/bin/install -m "$mode" "$source" "$destination"
  else
    /usr/bin/install -o root -g wheel -m "$mode" "$source" "$destination"
  fi
}

install_persistence_infrastructure() {
  local temp_dir helper_dir plist_dir plist_source

  helper_dir=$(/usr/bin/dirname "$PERSIST_HELPER")
  plist_dir=$(/usr/bin/dirname "$PERSIST_PLIST")
  temp_dir=$(/usr/bin/mktemp -d /tmp/cloudcheck-killswitch-persist.XXXXXX) || return 1
  plist_source="$temp_dir/$PERSIST_LABEL.plist"

  if ! /bin/mkdir -p "$helper_dir" "$plist_dir" "$PERSIST_STATE_DIR"; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 无法创建 Kill Switch 持久化目录"
    return 1
  fi
  if [ "$TEST_MODE" -eq 0 ]; then
    /bin/chmod 700 "$PERSIST_STATE_DIR" || {
      /bin/rm -rf "$temp_dir"
      echo "❌ 无法保护 Kill Switch 持久化状态目录"
      return 1
    }
  fi

  /usr/bin/printf '%s\n' \
    '<?xml version="1.0" encoding="UTF-8"?>' \
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
    '<plist version="1.0">' \
    '<dict>' \
    '  <key>Label</key>' \
    "  <string>$PERSIST_LABEL</string>" \
    '  <key>ProgramArguments</key>' \
    '  <array>' \
    "    <string>$PERSIST_HELPER</string>" \
    '    <string>restore</string>' \
    '  </array>' \
    '  <key>RunAtLoad</key>' \
    '  <true/>' \
    '  <key>ProcessType</key>' \
    '  <string>Background</string>' \
    '</dict>' \
    '</plist>' > "$plist_source"

  if ! /usr/bin/plutil -lint "$plist_source" >/dev/null 2>&1 \
    || ! install_private_file "$0" "$PERSIST_HELPER" 755 \
    || ! install_private_file "$plist_source" "$PERSIST_PLIST" 644; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 无法安装 Kill Switch 开机恢复服务"
    return 1
  fi

  /bin/rm -rf "$temp_dir"
}

persist_enabled_intent() {
  local marker_source
  marker_source=$(/usr/bin/mktemp /tmp/cloudcheck-killswitch-enabled.XXXXXX) || return 1
  /usr/bin/printf '%s\n' enabled > "$marker_source"
  if ! install_private_file "$marker_source" "$PERSIST_MARKER" 600; then
    /bin/rm -f "$marker_source"
    return 1
  fi
  /bin/rm -f "$marker_source"
}

clear_persisted_intent() {
  /bin/rm -f "$PERSIST_MARKER"
}

install_rules() {
  local interfaces temp_dir backup_path

  proxy_core_runs_as_root || return 1
  interfaces=$(detect_physical_interfaces) || {
    echo "❌ 无法自动识别物理网络接口，未做改动"
    return 1
  }
  if ! valid_interfaces "$interfaces"; then
    echo "❌ 自动识别到的物理网络接口不合法，未做改动"
    return 1
  fi
  if [ ! -r "$PF_TEMPLATE" ]; then
    echo "❌ 缺少 PF 规则模板，未做改动"
    return 1
  fi
  if [ ! -r "$MAIN_CONF" ]; then
    echo "❌ 无法读取 $MAIN_CONF，未做改动"
    return 1
  fi
  if [ ! -x "$PFCTL" ]; then
    echo "❌ 无法执行 PF 语法检查，未做改动"
    return 1
  fi

  temp_dir=$(/usr/bin/mktemp -d /tmp/cloudcheck-pf.XXXXXX) || return 1
  /usr/bin/sed \
    -e "s/__INTERFACES__/$interfaces/g" \
    "$PF_TEMPLATE" > "$temp_dir/$ANCHOR" || {
      /bin/rm -rf "$temp_dir"
      return 1
    }

  /bin/cp "$MAIN_CONF" "$temp_dir/pf.conf.original" || {
    /bin/rm -rf "$temp_dir"
    return 1
  }
  /bin/cp "$MAIN_CONF" "$temp_dir/pf.conf" || {
    /bin/rm -rf "$temp_dir"
    return 1
  }
  if ! /usr/bin/grep -qE "^[[:space:]]*anchor[[:space:]]+\"$ANCHOR\"" "$temp_dir/pf.conf"; then
    /usr/bin/printf '\nanchor "%s"\n' "$ANCHOR" >> "$temp_dir/pf.conf"
  fi

  if ! "$PFCTL" -a "$ANCHOR" -nf "$temp_dir/$ANCHOR" >/dev/null 2>&1; then
    /bin/rm -rf "$temp_dir"
    echo "❌ PF anchor 语法校验失败，未做改动"
    return 1
  fi
  if ! "$PFCTL" -nf "$temp_dir/pf.conf" >/dev/null 2>&1; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 系统 PF 配置语法校验失败，未做改动"
    return 1
  fi

  backup_path="$MAIN_CONF.cloudcheck.bak"
  if [ ! -e "$backup_path" ]; then
    /bin/cp -p "$MAIN_CONF" "$backup_path" || {
      /bin/rm -rf "$temp_dir"
      echo "❌ 无法备份系统 PF 配置，未做改动"
      return 1
    }
  fi

  if [ "$TEST_MODE" -eq 1 ]; then
    /bin/mkdir -p "$ANCHOR_DIR" "$TEST_ROOT/var/run" || {
      /bin/rm -rf "$temp_dir"
      return 1
    }
  fi
  if ! install_config_file "$temp_dir/pf.conf" "$MAIN_CONF"; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 无法注册 CloudCheck PF anchor"
    return 1
  fi
  if ! install_config_file "$temp_dir/$ANCHOR" "$ANCHOR_CONF"; then
    install_config_file "$temp_dir/pf.conf.original" "$MAIN_CONF" >/dev/null 2>&1 || true
    /bin/rm -rf "$temp_dir"
    echo "❌ 无法安装 CloudCheck PF anchor，已恢复系统配置"
    return 1
  fi
  if ! "$PFCTL" -f "$MAIN_CONF" >/dev/null 2>&1; then
    install_config_file "$temp_dir/pf.conf.original" "$MAIN_CONF" >/dev/null 2>&1 || true
    /bin/rm -f "$ANCHOR_CONF"
    "$PFCTL" -f "$MAIN_CONF" >/dev/null 2>&1 || true
    /bin/rm -rf "$temp_dir"
    echo "❌ 系统 PF 配置加载失败，已还原安装前状态"
    return 1
  fi
  /bin/rm -rf "$temp_dir"

  echo "✅ Kill Switch 规则已安装，当前保持关闭"
  echo "已完成 PF 语法检查，并保留首次配置备份"
}

ensure_existing_anchor_registered() {
  local temp_dir backup_path

  if /usr/bin/grep -qE "^[[:space:]]*anchor[[:space:]]+\"$ANCHOR\"" "$MAIN_CONF" 2>/dev/null; then
    return 0
  fi
  if [ ! -r "$ANCHOR_CONF" ]; then
    echo "❌ 未找到已安装的 Kill Switch 规则，未做改动"
    return 1
  fi
  if ! "$PFCTL" -a "$ANCHOR" -nf "$ANCHOR_CONF" >/dev/null 2>&1; then
    echo "❌ 已有 Kill Switch 规则校验失败，未做改动"
    return 1
  fi
  if [ ! -r "$MAIN_CONF" ]; then
    echo "❌ 无法读取 $MAIN_CONF，未做改动"
    return 1
  fi

  temp_dir=$(/usr/bin/mktemp -d /tmp/cloudcheck-pf-entry.XXXXXX) || return 1
  /bin/cp "$MAIN_CONF" "$temp_dir/pf.conf.original" || {
    /bin/rm -rf "$temp_dir"
    return 1
  }
  /bin/cp "$MAIN_CONF" "$temp_dir/pf.conf" || {
    /bin/rm -rf "$temp_dir"
    return 1
  }
  /usr/bin/printf '\nanchor "%s"\n' "$ANCHOR" >> "$temp_dir/pf.conf"

  if ! "$PFCTL" -nf "$temp_dir/pf.conf" >/dev/null 2>&1; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 系统 PF 配置校验失败，未做改动"
    return 1
  fi

  backup_path="$MAIN_CONF.cloudcheck-entry.bak"
  if [ ! -e "$backup_path" ]; then
    /bin/cp -p "$MAIN_CONF" "$backup_path" || {
      /bin/rm -rf "$temp_dir"
      echo "❌ 无法备份系统 PF 配置，未做改动"
      return 1
    }
  fi
  if ! install_config_file "$temp_dir/pf.conf" "$MAIN_CONF"; then
    /bin/rm -rf "$temp_dir"
    echo "❌ 无法恢复 Kill Switch 规则入口，未做改动"
    return 1
  fi
  if ! "$PFCTL" -f "$MAIN_CONF" >/dev/null 2>&1; then
    install_config_file "$temp_dir/pf.conf.original" "$MAIN_CONF" >/dev/null 2>&1 || true
    "$PFCTL" -f "$MAIN_CONF" >/dev/null 2>&1 || true
    /bin/rm -rf "$temp_dir"
    echo "❌ Kill Switch 规则入口恢复失败，已还原系统配置"
    return 1
  fi
  /bin/rm -rf "$temp_dir"
  echo "✅ 已恢复原有 Kill Switch 规则入口"
}

validate_anchor_ownership() {
  local owner mode
  if [ ! -r "$ANCHOR_CONF" ]; then
    echo "❌ 未找到已安装的 Kill Switch 规则，未做改动"
    return 1
  fi
  [ "$TEST_MODE" -eq 1 ] && return 0
  owner=$(/usr/bin/stat -f '%u' "$ANCHOR_CONF" 2>/dev/null || true)
  mode=$(/usr/bin/stat -f '%Lp' "$ANCHOR_CONF" 2>/dev/null || true)
  if [ "$owner" != "0" ] || [ -z "$mode" ] || [ $((8#$mode & 022)) -ne 0 ]; then
    echo "❌ Kill Switch 规则文件权限不安全，未做改动"
    return 1
  fi
}

pf_enabled() {
  "$PFCTL" -s info 2>/dev/null | /usr/bin/grep -q 'Status: Enabled'
}

anchor_rules() {
  "$PFCTL" -a "$ANCHOR" -sr 2>/dev/null
}

anchor_enabled() {
  pf_enabled && [ -n "$(anchor_rules)" ]
}

release_owned_reference() {
  local token
  [ -s "$TOKEN_FILE" ] || return 0
  token=$(/bin/cat "$TOKEN_FILE")
  if [ -n "$token" ]; then
    "$PFCTL" -X "$token" >/dev/null 2>&1 || true
  fi
  /bin/rm -f "$TOKEN_FILE"
}

enable_rules() {
  if [ "$BOOTSTRAP_DEFAULT" -eq 1 ]; then
    install_rules || return 1
  fi
  validate_anchor_ownership || return 1
  ensure_existing_anchor_registered || return 1
  if ! "$PFCTL" -a "$ANCHOR" -nf "$ANCHOR_CONF" >/dev/null 2>&1; then
    echo "❌ $ANCHOR_CONF 语法校验失败，未做改动"
    return 1
  fi
  if ! "$PFCTL" -a "$ANCHOR" -f "$ANCHOR_CONF" >/dev/null 2>&1; then
    echo "❌ Kill Switch anchor 加载失败"
    return 1
  fi

  if [ ! -s "$TOKEN_FILE" ]; then
    enable_output=$("$PFCTL" -E 2>&1)
    enable_status=$?
    token=$(/usr/bin/printf '%s\n' "$enable_output" | /usr/bin/awk '/Token[[:space:]]*:/ {print $NF; exit}')
    if [ "$enable_status" -ne 0 ]; then
      "$PFCTL" -a "$ANCHOR" -F rules >/dev/null 2>&1 || true
      echo "❌ PF 启用失败: $enable_output"
      return 1
    fi
    if [ -n "$token" ]; then
      /usr/bin/printf '%s\n' "$token" > "$TOKEN_FILE"
      /bin/chmod 600 "$TOKEN_FILE"
    fi
  fi

  if anchor_enabled; then
    echo "🛡️ Kill Switch 已开启 — 仅 $ANCHOR anchor 生效，不会覆盖其他 PF 规则"
  else
    release_owned_reference
    echo "❌ Kill Switch 启用后验证失败"
    return 1
  fi
}

case "$ACTION" in
  install)
    if [ "$#" -ne 1 ]; then
      echo "用法: cloudcheck-killswitch install"
      exit 2
    fi
    if /usr/bin/grep -qE \
      '^[[:space:]]*anchor[[:space:]]+"(cloudcheck|cloudlink-guard|cloudroute|puffroute|killswitch)"' \
      "$MAIN_CONF" 2>/dev/null; then
      echo "❌ 已存在 Kill Switch 规则入口，未覆盖"
      exit 1
    fi
    for candidate_anchor in cloudcheck cloudlink-guard cloudroute puffroute killswitch; do
      if [ -e "$ANCHOR_DIR/$candidate_anchor" ]; then
        echo "❌ 已存在 Kill Switch 规则文件，未覆盖"
        exit 1
      fi
    done
    install_rules
    ;;

  on)
    install_persistence_infrastructure || exit 1
    enable_rules || exit 1
    if ! persist_enabled_intent; then
      "$PFCTL" -a "$ANCHOR" -F rules >/dev/null 2>&1 || true
      release_owned_reference
      echo "❌ 无法保存 Kill Switch 开机恢复状态，已回滚本次开启"
      exit 1
    fi
    echo "✅ 已保存开机恢复状态，重启后将自动重新加载保护"
    ;;

  off)
    if ! "$PFCTL" -a "$ANCHOR" -F rules >/dev/null 2>&1; then
      echo "❌ Kill Switch anchor 清空失败"
      exit 1
    fi
    release_owned_reference
    if ! clear_persisted_intent; then
      echo "❌ Kill Switch 已在当前启动周期关闭，但无法清除开机恢复状态"
      exit 1
    fi
    echo "🔓 Kill Switch 已关闭 — 仅已清空 $ANCHOR anchor，未全局关闭 PF"
    echo "⚠️ 现在真实 IP 无 Kill Switch 保护，代理恢复后请重新开启"
    ;;

  restore)
    if [ "$#" -ne 1 ]; then
      echo "用法: cloudcheck-killswitch restore"
      exit 2
    fi
    if [ "$TEST_MODE" -eq 0 ] && [ "$0" != "$PERSIST_HELPER" ]; then
      echo "❌ 拒绝从非持久化 helper 调用开机恢复"
      exit 1
    fi
    if [ ! -r "$PERSIST_MARKER" ]; then
      echo "Kill Switch 未设置为开机恢复，保持关闭"
      exit 0
    fi
    enable_rules
    ;;

  status)
    pf_line=$("$PFCTL" -s info 2>/dev/null | /usr/bin/head -1)
    if anchor_enabled; then
      rule_count=$(anchor_rules | /usr/bin/awk 'NF {count++} END {print count+0}')
      echo "✅ Kill Switch: Enabled ($rule_count 条 anchor 规则)"
      echo "  $pf_line"
    elif pf_enabled; then
      echo "⚪️ Kill Switch: Disabled (anchor 为空，PF 由其他系统组件保持启用)"
      echo "  $pf_line"
    else
      echo "⚪️ Kill Switch: Disabled (PF 当前未启用)"
      [ -n "$pf_line" ] && echo "  $pf_line"
    fi
    ;;

  *)
    echo "用法: cloudcheck-killswitch install | on | off | status"
    exit 2
    ;;
esac
