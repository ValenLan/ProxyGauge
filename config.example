# Copy to ~/.config/proxygauge/config and fill in your own values.
PROXYGAUGE_MIXED="127.0.0.1:7890"
PROXYGAUGE_TIMEOUT="6"

# Optional: when set, the health check verifies the exact proxy exit IP.
PROXYGAUGE_EXPECT_IP=""

# Optional extra route/rule template. Disabled for a generic single-exit setup.
# The prefilled values cover a Google/Gemini/Claude chained exit.
PROXYGAUGE_MIHOMO_SOCKET="/private/tmp/verge/verge-mihomo.sock"
PROXYGAUGE_SECONDARY_ENABLED="0"
PROXYGAUGE_SECONDARY_LABEL="Google / Gemini / Claude"
PROXYGAUGE_SECONDARY_GROUP="Google-Chain"
PROXYGAUGE_DEFAULT_GROUP="PROXY"
PROXYGAUGE_SECONDARY_MIXED="127.0.0.1:7891"
PROXYGAUGE_SECONDARY_DOMAINS="gemini.google.com,generativelanguage.googleapis.com,www.google.com,claude.ai,api.anthropic.com,platform.claude.com,bridge.claudeusercontent.com"
PROXYGAUGE_EXPECT_SECONDARY_IP=""

# Off by default: active requests to AI APIs can create automated access logs.
PROXYGAUGE_ACTIVE_AI_PROBES="0"
