# Copy to ~/.config/puffroute/config and fill in your own values.
PUFFROUTE_MIXED="127.0.0.1:7890"
PUFFROUTE_TIMEOUT="6"

# Optional: when set, the health check verifies the exact proxy exit IP.
PUFFROUTE_EXPECT_IP=""

# Required only when installing the PF Kill Switch.
PUFFROUTE_VPS_IP=""
PUFFROUTE_INTERFACES="en0 en1 en2 en3 en4 en5 en6 en7 bridge0 bridge1 ppp0 ppp1"
