<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ProxyGauge"
           Manufacturer="Valen Lan"
           Version="$(ProductVersion)"
           UpgradeCode="820C3E68-02BB-43F8-9583-09AB23BE314F"
           Scope="perMachine"
           InstallerVersion="500"
           Codepage="65001"
           Compressed="yes">
    <SummaryInformation Description="ProxyGauge for Windows 11" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 ProxyGauge。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- msiexec runs under a Windows 8.1 compatibility manifest, so WindowsBuild/VersionNT
         always report 9600/603 even on Windows 11. Read the registry CurrentBuild instead;
         registry values are not subject to the version lie. -->
    <Property Id="WINDOWS_CURRENT_BUILD">
      <RegistrySearch Id="WindowsCurrentBuild"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuild"
                      Type="raw" />
    </Property>

    <Launch Condition="VersionNT64 AND MsiNTProductType = 1 AND WINDOWS_CURRENT_BUILD &gt;= 22000"
            Message="ProxyGauge 仅支持 64 位 Windows 11，不支持 Windows 10 或 Windows Server。" />

    <Icon Id="ProxyGaugeIcon.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ProxyGaugeIcon.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ProxyGauge">
        <Files Include="$(PublishDir)\**">
          <Exclude Files="$(PublishDir)\ProxyGauge.exe" />
        </Files>

        <Component Id="ProxyGaugeUiComponent" Bitness="always64">
          <File Id="ProxyGaugeUiExe" Source="$(PublishDir)\ProxyGauge.exe" KeyPath="yes">
            <Shortcut Id="ProxyGaugeStartMenuShortcut"
                      Directory="CommonProgramsFolder"
                      Name="ProxyGauge"
                      Advertise="yes"
                      WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="ProxyGaugeDesktopShortcut"
                      Directory="CommonDesktopFolder"
                      Name="ProxyGauge"
                      Advertise="yes"
                      WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>

        <Component Id="ProxyGaugeGuardComponent" Bitness="always64">
          <File Id="ProxyGaugeGuardExe" Source="$(GuardExe)" KeyPath="yes" />
          <ServiceInstall Id="ProxyGaugeGuardServiceInstall"
                          Name="ProxyGaugeGuard"
                          DisplayName="ProxyGauge Guard Service"
                          Description="Keeps ProxyGauge direct-IP leak protection active independently of the desktop UI."
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Vital="yes">
            <ServiceDependency Id="BFE" />
            <!-- The native ServiceConfigFailureActions table fails with access denied on
                 real systems (documented by the Windows Installer SDK, see WIX1149);
                 the util ServiceConfig applies the same restart policy via ChangeServiceConfig2.
                 util supports one delay for all three restarts instead of progressive delays. -->
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="3"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="ProxyGaugeGuardServiceControl"
                          Name="ProxyGaugeGuard"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
          <!-- The service owns these values. MSI upgrades must never reset an enabled Guard. -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\ProxyGauge\Guard" ForceCreateOnInstall="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonProgramsFolder" />
    <StandardDirectory Id="CommonDesktopFolder" />

    <CustomAction Id="CleanupProxyGaugeGuard"
                  FileRef="ProxyGaugeGuardExe"
                  ExeCommand="--uninstall-cleanup"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="CleanupProxyGaugeGuard"
              After="StopServices"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
